{
  "name": "beep-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "assets": "node scripts/generate-assets.mjs",
    "release": "npm run build && node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.1.0"
  }
}
